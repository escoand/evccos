variant: fcos
version: 1.7.0

passwd:
  users:
    - name: core
      password_hash: "$6$/bsPz.igJ3EslNvt$v62vEJkEaINcdUAbXp3PFB4RmPHX2jDwL1PLegTiJAC8G3Kl7tIOcsJMh.nEyZPHTGk1vrGMVfRo3zKreUUsb."
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINXVNVaVLWnPfyWK1oehq7/K9ppXKgPsRB5lZWp+fJI6 desktop
        - ssh-rsa  phone
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILLQ7xJbWDGtI5zDJHFRBWWhJiqVFP7uLhHQ9sUL5AlF homeassistant

storage:
  filesystems:
    # format
    - device: /dev/vdb
      format: ext4
      label: data
    # mount
    - device: /dev/disk/by-label/data
      format: ext4
      path: /var/mnt/data
      with_mount_unit: true
  # full image or use rebase.service
  trees:
  - local: filesystem
  directories:
    - path: /var/mnt/data
      mode: 0770
      user:
        name: core
      group:
        name: core
  links:
    - path: /etc/localtime
      target: /usr/share/zoneinfo/Europe/Berlin

systemd:
  units:
    #- name: rebase.service
    #  enabled: true
    #  contents_local: infra/rebase.service
