variant: fcos
version: 1.7.0

storage:
  filesystems:
    - device: /dev/disk/by-label/data
      format: ext4
      path: /var/mnt/data
      with_mount_unit: true
  directories:
    - path: /var/mnt/data
      mode: 0770
      user:
        name: core
      group:
        name: core
  links:
    - path: /etc/localtime
      target: /usr/share/zoneinfo/Europe/Berlin

systemd:
  units:
    - name: rebase.service
      enabled: true
      contents_local: infra/rebase.service

